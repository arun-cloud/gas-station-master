+  function middleware() {
+    return NextResponse.next()
+  },
+  {
+    callbacks: {
+      authorized: ({ token }) => {
+        // Must have a valid token AND an activated account.
+        return !!token && token.isActive === true
+      },
+    },
+    pages: {
+      signIn: '/login',
+    },
+  },
