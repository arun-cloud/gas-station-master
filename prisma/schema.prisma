generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ──────────────────────────────────────────────
model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  role     Role    @default(CASHIER)
  isActive Boolean @default(false)

  // Audit: who activated/last modified this account (nullable — self-registration has no actor)
  createdBy String?
  updatedBy String?

  userBranches UserBranch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales  Sale[]
  shifts Shift[]

  @@index([isActive])
}

// ─── User ↔ Branch access (many-to-many) ───────────────
model UserBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

// ─── Company ─────────────────────────────────────────────
model Company {
  id          String @id @default(cuid())
  nameEn      String
  nameAr      String
  legalNameEn String
  legalNameAr String

  // National Address Fields
  buildingNo   String
  street       String
  district     String
  city         String
  postalCode   String
  additionalNo String? // Often required in KSA National Address

  // Regulatory
  vatNumber String  @unique // 15 digits
  crNumber  String  @unique // 10 digits
  logo      String? // URL to the stored image

  // Relations
  branches  Branch[]
  referenceDataCategories ReferenceDataCategory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Reference Data ────────────────────────────────────────
model ReferenceDataCategory {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code        String
  nameEn      String
  nameAr      String?
  description String?
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ReferenceDataValue[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, nameEn])
}

model ReferenceDataValue {
  id String @id @default(cuid())

  categoryId String
  category   ReferenceDataCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  code         String
  nameEn       String
  nameAr       String?
  description  String?
  displayOrder Int     @default(0)
  isDefault    Boolean @default(false)
  isSystem     Boolean @default(false)
  isActive     Boolean @default(true)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, code])
  @@index([categoryId, isActive, displayOrder])
  @@index([categoryId, isDefault])
}

// ─── Branches ─────────────────────────────────────────────
model Branch {
  id         String @id @default(cuid())
  nameEn     String
  nameAr     String
  branchCode String @unique // Internal identifier (e.g., JED-01)

  // National Address (Branch Specific)
  buildingNo String
  street     String
  district   String
  city       String
  postalCode String

  // Relations
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  dispensers       Dispenser[]
  fuelTanks        FuelTank[]
  userBranches     UserBranch[]
  shifts           Shift[]
  supplierBranches SupplierBranch[]

  loyverseConnection LoyverseConnection?
  invoices           Invoice[]

  isActive Boolean @default(true)

  // Audit: who created/last modified this branch (nullable — seed data has no actor)
  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ─── Dispensers ─────────────────────────────────────────────
model Dispenser {
  id              String          @id @default(cuid())
  dispenserNumber Int
  branchId        String
  status          DispenserStatus @default(IDLE)
  isActive        Boolean         @default(true)

  // Audit: who created/last modified this dispenser
  createdBy String?
  updatedBy String?

  branch  Branch   @relation(fields: [branchId], references: [id])
  nozzles Nozzle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@unique([branchId, dispenserNumber])
  @@index([isActive])
}

enum DispenserStatus {
  IDLE
  ACTIVE
  MAINTENANCE
  OFFLINE
}

// ─── Nozzles ─────────────────────────────────────────────
model Nozzle {
  id             String   @id @default(cuid())
  nozzleNumber   Int
  fuelType       FuelType
  currentReading Decimal  @default(0) @db.Decimal(18, 3)
  dispenserID    String
  isActive       Boolean  @default(true)

  // Audit: who created/last modified this nozzle
  createdBy String?
  updatedBy String?

  dispenser Dispenser @relation(fields: [dispenserID], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@unique([dispenserID, nozzleNumber])
  @@index([isActive])
}

// ─── Fuel Inventory ────────────────────────────────────
model FuelTank {
  id           String   @id @default(cuid())
  tankNumber   Int
  branchId     String
  fuelType     FuelType
  capacity     Decimal
  currentLevel Decimal
  minLevel     Decimal // alert threshold
  isActive     Boolean  @default(true)

  // Audit: who created/last modified this tank
  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries FuelDelivery[]
  branch     Branch         @relation(fields: [branchId], references: [id])

  @@unique([branchId, tankNumber])
  @@index([isActive])
}

enum FuelType {
  PETROL_91
  PETROL_95
  DIESEL
  PREMIUM_DIESEL
}

// ─── Suppliers & Deliveries ────────────────────────────

enum SupplierType {
  FUEL
  PRODUCT
  SERVICE
  UTILITY
  GOVERNMENT
  OTHER
}

model Supplier {
  id               String       @id @default(cuid())
  supplierCode     String       @unique
  name             String // Legacy compatibility field; keep synchronized with nameEn
  nameEn           String
  nameAr           String?
  legalName        String?
  type             SupplierType @default(OTHER)
  vatNumber        String?      @unique
  crNumber         String?      @unique
  contactName      String?
  phone            String?
  email            String?
  address          String?
  city             String?
  paymentTermsDays Int          @default(0)
  creditLimit      Decimal      @default(0) @db.Decimal(18, 2)
  notes            String?
  isActive         Boolean      @default(true)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches       SupplierBranch[]
  deliveries     FuelDelivery[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive])
  @@index([type])
}

model SupplierBranch {
  id         String   @id @default(cuid())
  supplierId String
  branchId   String
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([supplierId, branchId])
  @@index([branchId])
}

model FuelDelivery {
  id              String   @id @default(cuid())
  tankId          String
  supplierId      String
  purchaseOrderId String
  litresDelivered Decimal
  pricePerLitre   Decimal
  deliveredAt     DateTime @default(now())
  notes           String?

  tank          FuelTank      @relation(fields: [tankId], references: [id])
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  orderNumber  String   @unique
  supplierId   String
  status       POStatus @default(PENDING)
  totalAmount  Decimal
  expectedDate DateTime
  createdAt    DateTime @default(now())

  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  items          POItem[]
  fuelDeliveries FuelDelivery[]
}

model POItem {
  id            String   @id @default(cuid())
  orderId       String
  fuelType      FuelType
  litres        Decimal
  pricePerLitre Decimal

  order PurchaseOrder @relation(fields: [orderId], references: [id])
}

enum POStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

// ─── Sales ─────────────────────────────────────────────
model Sale {
  id            String        @id @default(cuid())
  dispenserId   String
  userId        String
  customerId    String?
  fuelType      FuelType
  litres        Decimal
  pricePerLitre Decimal
  totalAmount   Decimal
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())

  dispenser Dispenser @relation(fields: [dispenserId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  nozzle    Nozzle?   @relation(fields: [nozzleId], references: [id])
  nozzleId  String?
}

enum PaymentMethod {
  CASH
  CARD
  LOYALTY_POINTS
}

// ─── Customers ─────────────────────────────────────────
model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  email         String?
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())

  sales Sale[]
}

// ─── Employees & Shifts ────────────────────────────────
model Shift {
  id          String      @id @default(cuid())
  userId      String
  startTime   DateTime
  endTime     DateTime?
  status      ShiftStatus @default(ACTIVE)
  openingCash Decimal
  closingCash Decimal?
  notes       String?

  user     User   @relation(fields: [userId], references: [id])
  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String
}

enum ShiftStatus {
  ACTIVE
  CLOSED
}

// ─── Loyverse Integration (Phase 3A: OAuth + token storage) ────
// One Loyverse "store" maps to exactly one Branch. OAuth consent in
// Loyverse is granted at the merchant level (not store-scoped), so the
// specific store is chosen by the admin/manager after the token exchange
// completes (see PENDING_STORE_SELECTION below).
enum LoyverseConnectionStatus {
  PENDING_STORE_SELECTION // token(s) stored, store not yet chosen
  CONNECTED
  DISCONNECTED
  ERROR
}

model LoyverseConnection {
  id String @id @default(cuid())

  branchId String @unique
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Loyverse-side store identity (set once the admin confirms the mapping)
  storeId   String?
  storeName String?

  status LoyverseConnectionStatus @default(PENDING_STORE_SELECTION)

  // Tokens are AES-256-GCM encrypted at rest — never stored or logged in
  // plaintext. See src/lib/integrations/loyverse/crypto.ts.
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenType             String   @default("Bearer")
  scope                 String?
  expiresAt             DateTime

  lastRefreshedAt DateTime?
  // Short, non-sensitive error summary only (never raw provider payloads).
  lastError       String?

  // ── Receipt sync (Phase 3B) ──
  // Watermark used as `updated_at_min` on the next poll — never rewound,
  // only advanced after a page of receipts has been durably upserted.
  lastReceiptSyncedAt  DateTime?
  lastReceiptSyncError String?

  // Audit: who initiated/last modified this connection
  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId])
  @@index([status])
}

// ─── Invoices (Phase 3B: receipt sync + Phase 4: invoice screens) ────
// An Invoice mirrors one Loyverse "receipt". It is intentionally a
// separate model from the legacy `Sale` model above: `Sale` is this app's
// own internal pump-side POS record, while `Invoice` is a read-through
// copy of a document that lives authoritatively in Loyverse. Loyverse does
// not allow editing an already-processed receipt via its API, so
// `Invoice` is a synced, view-only record — never a source of truth we
// write back from.
enum InvoiceSource {
  LOYVERSE
}

enum InvoiceSyncStatus {
  SYNCED
  ERROR
}

model Invoice {
  id String @id @default(cuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  source InvoiceSource @default(LOYVERSE)

  // Loyverse identity. `receiptNumber` is the natural key used for
  // idempotent upserts — the same receipt can never be inserted twice.
  loyverseReceiptNumber String
  loyverseStoreId       String
  loyverseOrder         String?
  loyversePosDeviceId   String?
  loyverseEmployeeId    String?
  loyverseCustomerId    String?
  receiptType           String  @default("SALE") // SALE | REFUND, as reported by Loyverse
  refundFor             String? // receiptNumber of the original sale, if this is a refund

  receiptDate DateTime
  currency    String   @default("SAR")

  totalMoney    Decimal @db.Decimal(18, 2)
  totalTax      Decimal @default(0) @db.Decimal(18, 2)
  totalDiscount Decimal @default(0) @db.Decimal(18, 2)
  totalPaid     Decimal @default(0) @db.Decimal(18, 2)
  cancelled     Boolean @default(false)

  syncStatus    InvoiceSyncStatus @default(SYNCED)
  lastSyncedAt  DateTime          @default(now())
  lastSyncError String?
  // Full receipt payload as returned by Loyverse — kept for audit/debug
  // and so re-mapping logic can evolve without re-fetching history.
  rawPayload    Json?

  isActive Boolean @default(true)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems InvoiceLineItem[]
  payments  InvoicePayment[]

  @@unique([branchId, loyverseReceiptNumber])
  @@index([branchId, receiptDate])
  @@index([branchId, isActive])
  @@index([syncStatus])
}

model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  loyverseLineItemId String?
  loyverseVariantId  String?
  itemName           String
  sku                String?
  quantity           Decimal  @db.Decimal(18, 3)
  price              Decimal  @db.Decimal(18, 2)
  cost               Decimal? @db.Decimal(18, 2)
  lineNote           String?
  grossTotal         Decimal  @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model InvoicePayment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  loyversePaymentTypeId String?
  paymentTypeName       String?
  moneyAmount           Decimal   @db.Decimal(18, 2)
  paidAt                DateTime?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}
