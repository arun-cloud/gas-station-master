# ── Database (Supabase-hosted Postgres) ──────────────────
# Pooled connection, used at runtime by the app
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection, used for migrations/seeding
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ── NextAuth ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-generated-32+-character-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── App ───────────────────────────────────────────────────
NODE_ENV="development"

# ── Loyverse (Phase 3A: OAuth + token storage) ───────────
# Client ID/Secret from your app at https://developer.loyverse.com
LOYVERSE_CLIENT_ID="replace-with-your-loyverse-app-client-id"
LOYVERSE_CLIENT_SECRET="replace-with-your-loyverse-app-client-secret"
# Publicly reachable base URL for this app (e.g. an ngrok/tunnel URL in
# local dev, or your production domain). Must NOT be committed with a real
# value — used to build the OAuth redirect URI below.
NEXT_PUBLIC_APP_URL="https://replace-with-your-public-app-url.example.com"
# Must exactly match the redirect URI registered in your Loyverse app.
LOYVERSE_REDIRECT_URI="https://replace-with-your-public-app-url.example.com/api/integrations/loyverse/callback"
# Generate with: openssl rand -base64 32
# Used to AES-256-GCM encrypt Loyverse access/refresh tokens at rest.
LOYVERSE_TOKEN_ENCRYPTION_KEY="replace-with-a-generated-base64-32-byte-key"

# ── Loyverse (Phase 3B: receipt sync) ────────────────────
# Cron expression for the in-process receipt-sync scheduler (started from
# src/instrumentation.ts). Defaults to every 5 minutes if unset.
LOYVERSE_SYNC_CRON="*/5 * * * *"
# Optional: only needed if you prefer triggering sync from an external
# cron/orchestrator instead of the in-process scheduler above, by calling
# POST /api/integrations/loyverse/sync-cron with this as a Bearer token.
# Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-a-generated-secret-or-leave-unset"
